# ─────────────────────────────────────────────────────────────────────────────
# TOTPVault — Environment Configuration Template
#
# Petunjuk:
# 1. Salin berkas ini menjadi .env:
#    cp .env.example .env
# 2. Sesuaikan konfigurasi di bawah sebelum menjalankan aplikasi atau compose.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Application Settings ──────────────────────────────────────────────────
APP_NAME=TOTPVault
APP_ENV=production                       # "production" atau "development"
APP_URL=https://totp.domain-anda.com     # URL publik aplikasi (harus HTTPS di server produksi)
APP_PORT=8080                            # Port ekspos host saat menggunakan Docker Compose

# ── 2. Database Configuration (MariaDB / MySQL) ──────────────────────────────
# Pada Docker Compose, DB_HOST gunakan "db". Pada VPS/Host lokal, gunakan "127.0.0.1".
DB_HOST=db
DB_PORT=3306
DB_NAME=totpvault
DB_USER=totpvault
DB_PASSWORD=ganti_password_database_kuat  # ⚠ Wajib ganti di server produksi
DB_ROOT_PASSWORD=ganti_root_password_db   # ⚠ Password root MariaDB untuk Docker

# ── 3. Security & Cryptography ───────────────────────────────────────────────
# Kunci enkripsi AES-256-GCM (Wajib tepat 32 karakter atau base64 32-byte).
# Generate kunci acak baru dengan perintah:
#   php -r "echo base64_encode(random_bytes(32)) . PHP_EOL;"
# ⚠ PENTING: Jangan ubah kunci ini setelah ada token 2FA yang tersimpan!
ENCRYPTION_KEY=GANTI_DENGAN_KUNCI_ENKRIPSI_32_BYTE_ACAK!

# Konfigurasi sesi pengguna
SESSION_COOKIE_NAME=totpvault_session
SESSION_LIFETIME=2592000                 # Durasi sesi dalam detik (2592000 = 30 hari)

# ── 4. Access Control & Initial Admin Seeding ────────────────────────────────
# Akun yang dituliskan di sini akan OTOMATIS didaftarkan sebagai Administrator
# ke dalam database saat compose / aplikasi dijalankan (dipisah koma):
ADMIN_EMAILS=admin@perusahaan.com,it-security@perusahaan.com

# (Opsional) Daftar email anggota reguler tambahan yang diizinkan masuk:
ALLOWED_EMAILS=

# (Opsional) Pembatasan domain organisasi (contoh: perusahaan.com):
ALLOWED_DOMAINS=

# ── 5. OAuth 2.0 / SSO Providers ─────────────────────────────────────────────
# Konfigurasi minimal satu provider untuk login anggota tim.

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${APP_URL}/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID (https://portal.azure.com)
# Authorized redirect URI: ${APP_URL}/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
# Authorized redirect URI: ${APP_URL}/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Keycloak / OIDC (Opsional)
# Authorized redirect URI: ${APP_URL}/auth/callback/keycloak
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=

# ── 6. Mail Notifications (Opsional) ────────────────────────────────────────
# Layanan email MailerSend jika diperlukan pengiriman notifikasi
MAILERSEND_KEY=
MAIL_FROM_EMAIL=noreply@perusahaan.com
MAIL_FROM_NAME=TOTPVault
